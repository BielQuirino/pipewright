import { createApp } from 'vue'
<% if (withPinia) { %>import { createPinia } from 'pinia'
<% } %><% if (withRouter) { %>import { createRouter, createWebHistory } from 'vue-router'
<% } %>import App from './App.vue'

const app = createApp(App)
<% if (withPinia) { %>app.use(createPinia())
<% } %><% if (withRouter) { %>app.use(createRouter({ history: createWebHistory(), routes: [] }))
<% } %>app.mount('#app')
